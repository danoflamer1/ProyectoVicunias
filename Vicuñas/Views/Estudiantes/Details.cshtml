@model Vicuñas.ViewModels.EstudianteDetailsViewModel



@{
    ViewData["Title"] = "Detalles del Estudiante";
}

<h1>Detalles del Estudiante</h1>

<h3>Datos Personales</h3>
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Estudiante.CI)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Estudiante.CI)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Estudiante.Nombres)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Estudiante.Nombres)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Estudiante.Apellido_P)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Estudiante.Apellido_P)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Estudiante.Apellido_M)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Estudiante.Apellido_M)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Estudiante.Sexo)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Estudiante.Sexo)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Estudiante.Fecha_Nac)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Estudiante.Fecha_Nac)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Estudiante.Paralelo.Nombre)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Estudiante.Paralelo.Nombre)</dd>

    <!-- Agrega más campos según necesites -->
</dl>

<h3>Mensajes</h3>
@if (Model.Mensajes.Any())
{
    <ul>
        @foreach (var mensaje in Model.Mensajes)
        {
            <li>@mensaje.Descripcion - @mensaje.Fecha.ToShortDateString()</li>
        }
    </ul>
}
else
{
    <p>No hay mensajes para este estudiante.</p>
}

<h3>Notas del Último Trimestre</h3>
@if (Model.Notas.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Materia</th>
                <th>Valor</th>
                <th>Trimestre</th>
                <th>Año</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var nota in Model.Notas)
            {
                <tr>
                    <td>@nota.Materia?.Nombre</td>
                    <td>@nota.Valor</td>
                    <td>@nota.Trimestre</td>
                    <td>@nota.Anio</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay notas registradas para este estudiante.</p>
}
<div>
	<a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
 </div>