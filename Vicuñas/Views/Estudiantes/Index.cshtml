@model IEnumerable<Vicuñas.Models.Estudiante>

@{
    ViewData["Title"] = "Lista de Estudiantes";
}

<style>
    .sticky-header {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: #fff;
        padding: 1rem;
        border-bottom: 1px solid #dee2e6;
    }

    .header-actions {
        display: flex;
        gap: .5rem;
        align-items: center;
        flex-wrap: wrap;
    }

    tr.selected {
        background-color: rgba(255, 235, 59, 0.15);
    }

    .table-container {
        margin-top: .5rem;
        padding: 1rem;
    }

    @@media (max-width: 576px) {
        .header-actions

    {
        flex-wrap: wrap;
    }

    }
</style>

<div class="sticky-header d-flex justify-content-between align-items-center">
    <h1 class="h4 mb-0">Lista de Estudiantes</h1>
    @if (User.IsInRole("Administrador"))
    {
    <div class="header-actions">
        <a asp-action="Create" class="btn btn-primary">Crear Nuevo</a>
            @if (User.IsInRole("Administrador"))
            {
                <a id="btnEditarHeader" class="btn btn-warning" style="display:none;">Editar</a>
            }
        <a id="btnDetailsHeader" class="btn btn-info" style="display:none;">Detalles</a>
    </div>
    }
</div>

<div class="table-container">
    <!-- Buscador por nombres -->
    <form method="get" asp-action="Index" class="mb-3">
        <div class="input-group">
            <input type="text" name="searchName" class="form-control" placeholder="Buscar por nombre..." value="@Context.Request.Query["searchName"]" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>

    <table class="table table-bordered table-striped" id="estudiantesTable">
        <thead>
            <tr>
                <th>Apellidos y Nombres</th>
                <th>CI</th>
                <th>Complemento</th>
                <th>Expedido</th>
                <th>Sexo</th>
                <th>Nro. Teléfono</th>
                <th>Nro. Celular</th>
                <th>Dirección</th>
                <th>Paralelo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr data-id="@item.Id">
                    <td>@item.Apellido_P @item.Apellido_M, @item.Nombres</td>
                    <td>@item.CI</td>
                    <td>@item.Ci_Complemento</td>
                    <td>@item.Ci_Expedido</td>
                    <td>@item.Sexo</td>
                    <td>@item.Nro_Telefono</td>
                    <td>@item.Nro_Celular</td>
                    <td>@item.Direccion</td>
                    <td>@item.Paralelo.Nombre</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        (function () {
            const table = document.getElementById('estudiantesTable');
            const btnEditar = document.getElementById('btnEditarHeader');
            const btnDetails = document.getElementById('btnDetailsHeader');
            let lastSelectedRow = null;

            const editUrlTemplate = '@Url.Action("Edit", "Estudiantes", new { id = "REPLACE_ID" })';
           const detailsUrlTemplate = '@Url.Action("Details", "Estudiantes", new { id = "REPLACE_ID" })';

            function showButtons(id) {
                btnEditar.href = editUrlTemplate.replace("REPLACE_ID", id);
                btnDetails.href = detailsUrlTemplate.replace("REPLACE_ID", id);
                btnEditar.style.display = 'inline-block';
                btnDetails.style.display = 'inline-block';
            }

            function hideButtons() {
                btnEditar.style.display = 'none';
                btnDetails.style.display = 'none';
            }

            table.addEventListener('dblclick', (e) => {
                const row = e.target.closest('tr');
                if (!row) return;
                const id = row.getAttribute('data-id');
                if (!id) return;

                if (lastSelectedRow && lastSelectedRow !== row) lastSelectedRow.classList.remove('selected');

                row.classList.toggle('selected');
                lastSelectedRow = row.classList.contains('selected') ? row : null;

                if (row.classList.contains('selected')) showButtons(id);
                else hideButtons();
            });

            document.addEventListener('click', (e) => {
                if (e.target.closest('#estudiantesTable')) return;
                if (e.target.closest('#btnEditarHeader') || e.target.closest('#btnDetailsHeader')) return;
                if (lastSelectedRow) lastSelectedRow.classList.remove('selected');
                hideButtons();
            });
        })();
    </script>
}



