                                    <label class="form-check-label" for="tiempoMediaHora">Entre media hora y una hora</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="tiempoTransporte" id="tiempoUnaDos" value="unaDos">
                                    <label class="form-check-label" for="tiempoUnaDos">Entre una a dos horas</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="tiempoTransporte" id="tiempoMasDos" value="masDos">
                                    <label class="form-check-label" for="tiempoMasDos">Más de dos horas</label>
                                </div>
                            </div>
                        </div>
             </div>

            <div class="form-section">
                    <h3 class="section-title">4.7 ABANDONO ESCOLAR CORRESPONDIENTE A LA GESTIÓN ANTERIOR</h3>

                        <div class="row mb-3">
                            <div class="col-md-12">
                        <h5 class="mt-4 mb-3 text-primary">4.7.1 ¿El estudiante abandono la Unidad Educativa el año pasado?</h5>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="abandonoEscolar" id="abandonoSi" value="si">
                                    <label class="form-check-label" for="abandonoSi">Sí</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="abandonoEscolar" id="abandonoNo" value="no">
                                    <label class="form-check-label" for="abandonoNo">No (Pase a la Seccion de Padres)</label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3" id="razonesAbandonoContainer" style="display: none;">
                            <div class="col-md-12">
                        <h5 class="mt-4 mb-3 text-primary">4.7.2 ¿Cual o cuales fueron las razones de abandono escolar? (Puede marcar más de una opción)</h5>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonAyudaPadres" name="razonesAbandono[]" value="ayudaPadres">
                                            <label class="form-check-label" for="razonAyudaPadres">Tuvo que ayudar a sus padres en su trabajo</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonTrabajoRemunerado" name="razonesAbandono[]" value="trabajoRemunerado">
                                            <label class="form-check-label" for="razonTrabajoRemunerado">Tuvo trabajo remunerado</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonFaltaDinero" name="razonesAbandono[]" value="faltaDinero">
                                            <label class="form-check-label" for="razonFaltaDinero">Falta de dinero</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonEdad" name="razonesAbandono[]" value="edad">
                                            <label class="form-check-label" for="razonEdad">Edad temprana (precozidad) / edad tardía (rezago)</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonLejos" name="razonesAbandono[]" value="lejos">
                                            <label class="form-check-label" for="razonLejos">La Unidad Educativa estaba muy lejos</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonLaboresCasa" name="razonesAbandono[]" value="laboresCasa">
                                            <label class="form-check-label" for="razonLaboresCasa">Labores de casa/cuidado de miembros del hogar</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonEmbarazo" name="razonesAbandono[]" value="embarazo">
                                            <label class="form-check-label" for="razonEmbarazo">Embarazo o paternidad</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonEnfermedad" name="razonesAbandono[]" value="enfermedad">
                                            <label class="form-check-label" for="razonEnfermedad">Por enfermedad/accidente/discapacidad</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonViaje" name="razonesAbandono[]" value="viaje">
                                            <label class="form-check-label" for="razonViaje">Viaje o traslado</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonFaltaInteres" name="razonesAbandono[]" value="faltaInteres">
                                            <label class="form-check-label" for="razonFaltaInteres">Falta de interés</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonViolenciaFisica" name="razonesAbandono[]" value="violenciaFisica">
                                            <label class="form-check-label" for="razonViolenciaFisica">Violencia física</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonViolenciaPsicologica" name="razonesAbandono[]" value="violenciaPsicologica">
                                            <label class="form-check-label" for="razonViolenciaPsicologica">Violencia psicológica</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonViolenciaSexual" name="razonesAbandono[]" value="violenciaSexual">
                                            <label class="form-check-label" for="razonViolenciaSexual">Violencia sexual</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="razonOtro" name="razonesAbandono[]" value="otro">
                                            <label class="form-check-label" for="razonOtro">Otro (especificar)</label>
                                            <input type="text" class="form-control mt-1" id="razonOtroEspecificar" name="razonOtroEspecificar" placeholder="Especifique" disabled>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
            </div>
            <div class="d-flex justify-content-between mb-5">
                <a class ="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
                <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="RudePadres">
                    <i class="fas fa-check me-2"></i>Siguiente
                </a>
            </div>
        </form>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Generar código RUDE automáticamente (simulación)
        document.addEventListener('DOMContentLoaded', function() {
            // Simular generación de código RUDE
            const randomCode = 'RUDE-' + Math.floor(100000 + Math.random() * 900000);
            document.getElementById('codigoRUDE').value = randomCode;

            document.getElementById('rudeForm').addEventListener('submit', function(e) {
                e.preventDefault();
                alert('Formulario enviado con éxito. En una implementación real, los datos se enviarían al servidor.');
            });
        });
                // JavaScript para mostrar/ocultar campos según selecciones
        document.addEventListener('DOMContentLoaded', function() {
            // Mostrar/ocultar meses de trabajo
            const trabajoSi = document.getElementById('trabajoSi');
            const trabajoNo = document.getElementById('trabajoNo');
            const trabajoNsNr = document.getElementById('trabajoNsNr');
            const mesesTrabajoContainer = document.getElementById('mesesTrabajoContainer');
            const actividadTrabajoContainer = document.getElementById('actividadTrabajoContainer');
            const turnosTrabajoContainer = document.getElementById('turnosTrabajoContainer');
            const frecuenciaTrabajoContainer = document.getElementById('frecuenciaTrabajoContainer');
            const pagoTrabajoContainer = document.getElementById('pagoTrabajoContainer');

            function toggleTrabajoCampos() {
                if (trabajoSi.checked) {
                    mesesTrabajoContainer.style.display = 'block';
                    actividadTrabajoContainer.style.display = 'block';
                    turnosTrabajoContainer.style.display = 'block';
                    frecuenciaTrabajoContainer.style.display = 'block';
                    pagoTrabajoContainer.style.display = 'block';
                } else {
                    mesesTrabajoContainer.style.display = 'none';
                    actividadTrabajoContainer.style.display = 'none';
                    turnosTrabajoContainer.style.display = 'none';
                    frecuenciaTrabajoContainer.style.display = 'none';
                    pagoTrabajoContainer.style.display = 'none';
                }
            }

            trabajoSi.addEventListener('change', toggleTrabajoCampos);
            trabajoNo.addEventListener('change', toggleTrabajoCampos);
            trabajoNsNr.addEventListener('change', toggleTrabajoCampos);

            // Mostrar/ocultar tipo de pago
            const pagoSi = document.getElementById('pagoSi');
            const tipoPagoContainer = document.getElementById('tipoPagoContainer');

            pagoSi.addEventListener('change', function() {
                tipoPagoContainer.style.display = this.checked ? 'block' : 'none';
            });

                    // Mostrar/ocultar razones de abandono
        const abandonoSi = document.getElementById('abandonoSi');
        const abandonoNo = document.getElementById('abandonoNo');
        const razonesAbandonoContainer = document.getElementById('razonesAbandonoContainer');

        function toggleAbandonoCampos() {
            if (abandonoSi.checked) {
                razonesAbandonoContainer.style.display = 'block';
            } else {
                razonesAbandonoContainer.style.display = 'none';
                // Limpiar todos los campos de razones cuando se selecciona "No"
                document.querySelectorAll('#razonesAbandonoContainer input[type="checkbox"]').forEach(cb => {
                    cb.checked = false;
                });
                // Deshabilitar y limpiar campo "Otro especificar"
                const razonOtroEspecificar = document.getElementById('razonOtroEspecificar');
                if (razonOtroEspecificar) {
                    razonOtroEspecificar.disabled = true;
                    razonOtroEspecificar.value = '';
                }
            }
        }

        // Agregar event listeners a ambos botones (Sí y No)
        abandonoSi.addEventListener('change', toggleAbandonoCampos);
        abandonoNo.addEventListener('change', toggleAbandonoCampos);

        // Ejecutar al cargar para establecer el estado inicial
        toggleAbandonoCampos();
        });
    </script>
</body>
</html>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
